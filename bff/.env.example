# Which LLM provider src/llm/client.ts should call: "anthropic" | "meta" | "groq".
# Any other value (or a missing key below) makes /action/explain fall back to
# a templated response instead of erroring.
LLM_PROVIDER=anthropic

# API key for the provider above. Leave unset to exercise the graceful fallback.
LLM_API_KEY=

# Optional, "meta"/"groq" providers only. Override if your account uses a
# different host/model than the defaults baked into src/llm/client.ts.
# LLM_BASE_URL=https://api.meta.ai/v1/chat/completions
# LLM_MODEL=muse-spark-1.2

PORT=3000
